# Netlify build-time variable
VITE_API_URL=https://your-render-service.onrender.com

# Render runtime variables
SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=https://your-netlify-site.netlify.app,http://localhost:5173,http://127.0.0.1:5173
# Keep SQLite locally; use a Render persistent disk path only if you explicitly configure one.
DATABASE_URL=sqlite:///./app.db
